# Copy to .env and fill in real values. .env is gitignored — never commit secrets.
# MiniMax LLM API key (V2.0). Get one at https://platform.minimaxi.com
MINIMAX_API_KEY=<your-minimax-api-key>
# Optional: MiniMax API base
# MINIMAX_API_BASE=https://api.minimaxi.com/v1
# Demo admin login (POST /auth/login). Defaults to admin / admin123 if unset.
# Override only for a real deployment — this is NOT a security boundary.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin123
